#     RewriteEngine On
#     RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/ [NC]
#     RewriteCond %{HTTPS} !=on
#     RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]
# </IfModule>

# This is a multipage site. Do not add a catch-all SPA rewrite.
